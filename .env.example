# ==============================================================================
# VARIABLES DE ENTORNO - SISTEMA CLÍNICO MTC & AURICULOTERAPIA
# ==============================================================================
# Configura estas variables en tu panel de Vercel (Settings -> Environment Variables)
# y en tu archivo local .env para desarrollo.

# URL de tu proyecto Supabase (Ejemplo: https://xyzcompany.supabase.co)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Llave pública anónima (anon public key) de Supabase
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ejemplo...

# Esquema de base de datos dedicado (clinica_mtc para aislar de proyectos gratuitos compartidos)
SUPABASE_SCHEMA=clinica_mtc
